{
  "name": "@chaireblockchainulaval/bnaas-connect",
  "version": "1.0.0",
  "description": "SDK « Se connecter avec BNAAS » V2 — consentement du notaire à chaque opération notariale, jeton d'identité notariale lié à l'opération (OAuth 2.0 + PKCE).",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "bnaas",
    "oauth",
    "pkce",
    "notarial",
    "sdk"
  ],
  "license": "UNLICENSED",
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChaireBlockchainULaval/bnaas-connect.git"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^3.2.7"
  }
}
